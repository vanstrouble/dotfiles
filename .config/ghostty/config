command = /bin/zsh
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/Ghostty.icns
click-repeat-interval = 500
auto-update-channel = stable
window-width = 110
window-height = 40
window-save-state = default
resize-overlay = never
shell-integration = zsh
shell-integration-features = no-cursor, title, ssh-terminfo
theme = catppuccin-macchiato.conf
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 16
font-thicken = true
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
bell-features = no-attention, no-system

initial-window = false
macos-hidden = always

keybind = global:opt+escape=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 70%,80%
quick-terminal-screen = main
window-save-state = never